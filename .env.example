# ─────────────────────────────────────────────
# NLP Email Assistant — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────

# ── OpenAI ──────────────────────────────────
# Free-tier key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Gmail ────────────────────────────────────
# Email address to automate
EMAIL_ADDRESS=rsayan570@gmail.com

# Path to your Google OAuth2 credentials JSON file
# Download from https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CREDENTIALS_FILE=credentials.json

# ── Server ───────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Application ──────────────────────────────
# App secret (change to a random string in production)
SECRET_KEY=change-me-to-a-random-secret

# Debug mode (set to False in production)
DEBUG=True
